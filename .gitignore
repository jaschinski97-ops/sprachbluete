# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local generator drafts and temporary verification builds (never shipped)
/.content-studio/
/build-verification/

# Lokale Ablage — alles, was nie auf GitHub soll, heißt *_Local
/_Local/
/.agent/
/.claude/
*_Local/
*_Local.*

# Playwright-Automationsartefakte (Snapshots, Konsolenlogs) — nur lokal
/.playwright-mcp/

# Generierte Mess-/Pruefberichte und Laufprotokolle (zehntausende Dateien,
# jederzeit regenerierbar) — nur lokal
/pipeline/reports/
/pipeline/logs/

# Katalog je Lernsprache: beim Metro-Start erzeugt (scripts/app-catalog-files.cjs)
/assets/catalog/

# Messungen von scripts/measure-android-start.sh
/measurements/

# Web-Content-Spiegel (204 MB Binärdateien, per `npm run web:content` regeneriert)
/public/

# Lokale Screenshots und Werkzeug-Konfigurationen
design-review-shots/
gui-test-screenshots/
.zcodeignore
