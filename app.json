{
  "expo": {
    "name": "Thai Lernbegleiter",
    "slug": "thai-lernbegleiter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thailernbegleiter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.thailernbegleiter.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07071A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thailernbegleiter.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07071A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "microphonePermission": "The app uses the microphone only for the speaking exercises. The recording stays on this device; the analysis runs locally and sends no audio to any provider.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-localization",
      "expo-image",
      "expo-sharing"
    ],
    "locales": {
      "en": {
        "ios": {
          "NSMicrophoneUsageDescription": "The app uses the microphone only for the speaking exercises. The recording stays on this device; the analysis runs locally and sends no audio to any provider."
        }
      },
      "de": {
        "ios": {
          "NSMicrophoneUsageDescription": "Die App nutzt das Mikrofon nur für die Sprechübungen. Die Aufnahme bleibt auf diesem Gerät; die Auswertung läuft lokal und sendet keine Audiodaten an einen Anbieter."
        }
      },
      "es": {
        "ios": {
          "NSMicrophoneUsageDescription": "La app usa el micrófono solo para los ejercicios de hablar. La grabación se queda en este dispositivo; el análisis se hace localmente y no envía audio a ningún proveedor."
        }
      },
      "th": {
        "ios": {
          "NSMicrophoneUsageDescription": "แอปใช้ไมโครโฟนเฉพาะในแบบฝึกพูด เสียงที่บันทึกจะอยู่ในอุปกรณ์นี้เท่านั้น การวิเคราะห์ทำในเครื่องและไม่ส่งข้อมูลเสียงไปยังผู้ให้บริการใด"
        }
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "pack": {
        "repo": "jaschinski97-ops/nico_sprachApp_Linguistik",
        "baseUrlOverride": null
      }
    }
  }
}
