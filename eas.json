{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "rc-ios": {
      "extends": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "rc-ios-packs": {
      "extends": "rc-ios",
      "env": {
        "THAISPEAKER_MEDIA": "packs",
        "EXPO_PUBLIC_LERNSPRACHEN": "th,en,es,de,fr,pt,it,zh,ja"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "THAISPEAKER_MEDIA": "embedded"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "THAISPEAKER_MEDIA": "packs",
        "EXPO_PUBLIC_LERNSPRACHEN": "th,en,es,de,fr,pt,it,zh,ja"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {
      "ios": {
        "ascAppId": "6827304550"
      }
    }
  }
}
