{
  "name": "thai-lernbegleiter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-zip-archive": "^9.5.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "ffmpeg-static": "^5.3.0",
    "globals": "^14.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --max-workers 2",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --max-workers 2",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "export:web": "npm run web:content && expo export --platform web",
    "content:studio": "node scripts/content/studio.cjs",
    "content:check": "node scripts/content/check.cjs",
    "content:integrity": "node scripts/content/check.cjs --integrity-only",
    "test:content-pipeline": "node --test scripts/content/pipeline.test.cjs",
    "pack:build": "node scripts/content/build-pack.cjs",
    "pack:publish": "node scripts/pipeline/publish-pack.cjs",
    "test:pack-build": "node --test scripts/content/build-pack.test.cjs",
    "test:pipeline-report": "node --test scripts/content/pipeline-report.test.cjs",
    "test:scripts": "node --test \"scripts/**/*.test.cjs\"",
    "eas-build-post-install": "node scripts/content/eas-gate.cjs",
    "verify:production": "node scripts/content/verify-production.cjs",
    "content:measure-tones": "node scripts/content/measure-tones.cjs scripts/content/fixtures/tones/index.json",
    "content:tone-report": "node scripts/content/tone-report.cjs",
    "content:thai-tones": "node scripts/content/thai-tones.cjs",
    "content:tone-calibration": "node scripts/content/tone-calibration.cjs",
    "pipeline:release": "node scripts/release-pipeline.cjs",
    "content:tone-tool": "node scripts/build-tone-tool.cjs --check",
    "audit:structure": "node scripts/audit-structure.cjs",
    "web:content": "node scripts/sync-web-content.cjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/jest.style-mock.js"
    }
  }
}
